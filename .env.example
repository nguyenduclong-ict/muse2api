MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=9123
MUSE2API_KEY=
MUSE2API_DATA_DIR=data
MUSE2API_KEEPALIVE_INTERVAL_MINUTES=20
MUSE2API_SYSTEM_PROMPT_ENABLED=0
MUSE2API_MEDIA_CLEANUP_ENABLED=1
MUSE2API_MEDIA_RETENTION_DAYS=1
MUSE2API_MEDIA_MAX_GB=1.0
MUSE2API_CLEANUP_INTERVAL_MINUTES=60
MUSE2API_LOG_LEVEL=INFO
MUSE2API_AUDIO_NORMALIZE=1
# MUSE2API_AUDIO_TARGET_LUFS=-16.0
# MUSE2API_AUDIO_TRUE_PEAK=-1.5
# MUSE2API_AUDIO_LRA=11.0
# MUSE2API_SQLITE_JOURNAL_MODE=  # Optional: auto (TRUNCATE on 9p/network mounts, WAL on native FS)
# MUSE2API_DB_PATH=  # Optional: separate SQLite path (Docker uses /app/db/muse2apiv2.db on native volume)
MUSE2API_RESET_WAIT_TIMEOUT_SECONDS=150
MUSE2API_RESET_MAX_WAITERS=50
